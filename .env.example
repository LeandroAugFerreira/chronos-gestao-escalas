# Chronos 1.0 — Fase 9. Sem segredos reais. O setup gera uma configuração local.
CHRONOS_ENVIRONMENT=development
CHRONOS_ALLOWED_ORIGINS=http://127.0.0.1:5187,http://localhost:5187
# Diretório de runtime fora do OneDrive; configure em PowerShell antes dos scripts.
# CHRONOS_RUNTIME_DIR=C:\Users\SEU_USUARIO\AppData\Local\Chronos\1.0
# PostgreSQL preferencial: postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5547/chronos
# SQLite local opt-in: sqlite+pysqlite:///C:/CAMINHO_FORA_ONEDRIVE/chronos.sqlite3
CHRONOS_DATABASE_URL=
CHRONOS_ALLOW_SQLITE=false
# Ao menos 32 caracteres aleatórios; nunca usar valor de exemplo em produção.
CHRONOS_JWT_SECRET=
CHRONOS_ACCESS_MINUTES=15
CHRONOS_REFRESH_DAYS=7
CHRONOS_LOGIN_LIMIT=8
CHRONOS_LOGIN_WINDOW_SECONDS=300
# true obrigatório em produção (HTTPS); false somente no desenvolvimento local HTTP.
CHRONOS_COOKIE_SECURE=false
# Limite de corpo antes do parsing (bytes) e prazo de recebimento (segundos).
CHRONOS_MAX_REQUEST_BYTES=1048576
CHRONOS_REQUEST_BODY_SECONDS=10
# Somente para testes PostgreSQL em banco exclusivo com nome terminado em _test:
# CHRONOS_TEST_POSTGRES_URL=postgresql+psycopg://USUARIO:SENHA@127.0.0.1:5547/chronos_test
# Integração n8n em development bloqueada pela auditoria da Fase 9. Mantenha vazio.
# Ambiente test reservado a contratos/receptores sintéticos, sem partida do runtime bloqueado.
# Exemplo de base local: http://127.0.0.1:5687/webhook/chronos
CHRONOS_N8N_WEBHOOK_BASE_URL=
# Token aleatório de saída, >=32 caracteres, igual ao Header Auth do Webhook n8n.
CHRONOS_N8N_OUTBOUND_TOKEN=
# Reserva da Fase 8; não ativa serviço de IA nesta fase.
AI_ENABLED=false
